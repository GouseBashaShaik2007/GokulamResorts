# ---------------------------------------------------------
# Gokulam Resorts - Backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development


# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:3000

# Staff sign-ins are kept in cookies the browser only sends when the site and
# this API are on the same domain, or sub-domains of one — for example
# gokulamresorts.in and api.gokulamresorts.in. On two unrelated domains
# (something.vercel.app and something.onrender.com) staff CANNOT sign in.
# COOKIE_DOMAIN: optional, e.g. .gokulamresorts.in, to share the cookie with
# every sub-domain. Leave unset for local development.
# COOKIE_DOMAIN=
# COOKIE_SAMESITE: strict (default) | lax | none. Leave it alone unless you know why.
# COOKIE_SAMESITE=strict

# Number of proxies in front of the API (1 on Render and most hosts). Needed so
# rate limits count each visitor separately. Leave unset for local development;
# defaults to 1 when NODE_ENV=production.
# TRUST_PROXY=1

# PostgreSQL — Supabase project connection string (Project Settings → Database
# → Connection string → URI). Requires SSL.
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres
PGSSL=true

# Supabase project (Project Settings → API / Data API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# SECRET — server-only, bypasses row-level security. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT (used for admin login sessions)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Admin bootstrap credentials (used only by `npm run db:seed`)
ADMIN_EMAIL=admin@gokulamresorts.com
ADMIN_PASSWORD=ChangeMe123!

# Kitchen display: each cook signs in with their own PIN, not a shared device
# password. `npm run db:seed` creates a first cook only if you set
# KITCHEN_STAFF_SEED_PIN (4-6 digits, not a run like 1234); otherwise add cooks
# in Admin -> Settings. Session is long-lived since
# it's a wall tablet staff sign into once per shift, not a desktop admin session.
KITCHEN_JWT_EXPIRES_IN=12h

# Food ordering links: every printed QR code carries a key derived from this
# secret, and orders are refused without it. Falls back to JWT_SECRET when
# unset. Changing it makes every printed code stop working (reprint them from
# Admin -> QR Codes), which is also how you retire leaked codes.
# ORDER_LINK_SECRET=another_long_random_string

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx


# Housekeeping: nightly cleaning-job generation (cron syntax, resort timezone)
CLEANING_CRON=0 23 * * *
# Housekeeping's two daily rounds, as hours of the day (0-23) at the resort.
# From STAYOVER_HOUR every occupied room gets a stayover job (bed, toiletries,
# toilet). From CHECKOUT_HOUR a guest who is due out and still checked in is
# "late": the room is marked dirty and the front desk is warned.
STAYOVER_HOUR=9
CHECKOUT_HOUR=11
STAFF_JWT_EXPIRES_IN=12h

# Resort timezone — booking dates, 'today', and all scheduled jobs use it.
RESORT_TIMEZONE=Asia/Kolkata

# Online bookings: minutes a room is held while the guest pays. Paying
# confirms the booking; nobody has to approve it.
BOOKING_HOLD_MINUTES=15

# Razorpay mode: live | mock. Unset = live when real keys are present, else mock.
# mock is refused when NODE_ENV=production.
# RAZORPAY_MODE=mock
# Webhook secret from Razorpay Dashboard -> Webhooks. Point the webhook at
# https://<api-host>/api/razorpay/webhook with events payment.captured,
# refund.processed, refund.failed. Food paid online (the restaurant kiosk, a
# hotel room's "pay now") relies on it too: it is how an order is placed when
# a customer has paid but their screen lost its connection before it could say so.
RAZORPAY_WEBHOOK_SECRET=

# Guest ID documents — Supabase Storage (private bucket, via service_role key
# above). local = backend/private_uploads, development only. s3 = any other
# S3-compatible bucket (S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY,
# optional S3_ENDPOINT for R2 / Spaces / MinIO).
STORAGE_DRIVER=supabase
SUPABASE_DOCS_BUCKET=guest-documents
# Days after check-out (or cancellation) before ID files are deleted. Max 180.
DOC_RETENTION_DAYS=90

# Public images (rooms, menu items) — Supabase Storage, public buckets.
SUPABASE_FOOD_IMAGES_BUCKET=food-images
SUPABASE_ROOM_IMAGES_BUCKET=room-images

# Guest messages about bookings and food orders. 'log' records them in the
# notifications table without sending. See src/services/notify.service.js.
NOTIFY_DRIVER=log
# Which kinds of message are written: sms (the default), whatsapp, email.
# NOTIFY_CHANNELS=sms
